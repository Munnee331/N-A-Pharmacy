{
  "name": "na-pharma-backend",
  "version": "1.0.0",
  "description": "N A Pharma — MERN backend REST API",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "npx nodemon src/server.js",
    "start": "node src/server.js",
    "seed:admin": "node src/seeder/createAdmin.js",
    "seed:pharmacist": "node src/seeder/createPharmacist.js",
    "seed:medicines": "node src/seeder/seedMedicines.js",
    "seed:all": "npm run seed:admin && npm run seed:pharmacist && npm run seed:medicines",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "N A Pharma",
  "license": "MIT",
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.6",
    "mongodb-memory-server": "^11.1.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.2.2",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.6.2",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "na-pharma-root": "file:..",
    "nodemailer": "^8.0.7",
    "pdfkit": "^0.18.0",
    "sslcommerz-lts": "^1.2.0"
  }
}
